### GET PROFILE / TOKEN TEST
# Catatan: Jalankan login terlebih dahulu untuk mendapatkan token.
# Ganti string setelah 'Bearer ' dengan token yang didapatkan dari respons login.
GET http://localhost:3000/api/auth/me
Authorization: Bearer PASTE_TOKEN_DARI_RESPONSE_LOGIN

